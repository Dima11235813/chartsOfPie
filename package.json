{
  "name": "charts-of-pie",
  "private": true,
  "description": "Math is Art: explore, visualize and listen to mathematics — starting with the digits of π.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @charts-of-pie/web",
    "build": "npm run build -w @charts-of-pie/web",
    "preview": "npm run preview -w @charts-of-pie/web",
    "test": "npm run test -w @charts-of-pie/web",
    "test:e2e": "npm run test:e2e -w @charts-of-pie/web",
    "lint": "npm run lint -w @charts-of-pie/web",
    "typecheck": "npm run typecheck -w @charts-of-pie/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
