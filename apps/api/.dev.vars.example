# Local overrides for `npm run api:dev` (wrangler dev). Copy to .dev.vars (git-ignored).
# Must list the web dev server's origin, using the port from apps/web/.env.local.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# A GitHub OAuth app for localhost (callback http://localhost:8787/auth/github/callback):
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
