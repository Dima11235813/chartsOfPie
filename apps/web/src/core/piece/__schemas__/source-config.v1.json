{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "series": {
      "type": "string",
      "enum": [
        "pi",
        "phi",
        "e",
        "sqrt2"
      ]
    },
    "reading": {
      "type": "string",
      "enum": [
        "digits"
      ]
    }
  },
  "required": [
    "version",
    "series",
    "reading"
  ]
}
