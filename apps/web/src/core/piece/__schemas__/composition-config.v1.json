{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "scale": {
      "type": "string",
      "enum": [
        "major-pentatonic",
        "minor-pentatonic",
        "ionian",
        "dorian",
        "phrygian",
        "lydian",
        "mixolydian",
        "aeolian",
        "locrian",
        "harmonic-minor",
        "melodic-minor",
        "blues",
        "whole-tone",
        "chromatic"
      ]
    },
    "root": {
      "type": "string",
      "enum": [
        "C",
        "C#",
        "D",
        "D#",
        "E",
        "F",
        "F#",
        "G",
        "G#",
        "A",
        "A#",
        "B"
      ]
    },
    "octave": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5
    },
    "mapping": {
      "type": "string",
      "enum": [
        "ascending",
        "centred",
        "wrap",
        "semitones"
      ]
    },
    "rhythm": {
      "type": "string",
      "enum": [
        "legacy",
        "steady",
        "steady-rests",
        "digit-length"
      ]
    },
    "timing": {
      "type": "string",
      "enum": [
        "legacy-random",
        "tempo"
      ]
    },
    "bpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 240
    },
    "subdivision": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "swing": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "legato": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "dynamics": {
      "type": "string",
      "enum": [
        "flat",
        "accented"
      ]
    },
    "humanize": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "instrument": {
      "type": "string",
      "enum": [
        "classic",
        "piano",
        "electric-piano",
        "music-box",
        "marimba",
        "harp",
        "warm-pad",
        "pure-sine",
        "electric-guitar",
        "acoustic-guitar",
        "wurlitzer",
        "clavinet",
        "organ",
        "analog-synth"
      ]
    },
    "reverb": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "echo": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "drone": {
      "type": "boolean"
    },
    "compress": {
      "type": "boolean"
    },
    "volume": {
      "type": "number",
      "minimum": -30,
      "maximum": 6
    }
  },
  "required": [
    "version",
    "scale",
    "root",
    "octave",
    "mapping",
    "rhythm",
    "timing",
    "bpm",
    "subdivision",
    "legato",
    "dynamics",
    "humanize",
    "instrument",
    "reverb",
    "echo",
    "drone",
    "compress",
    "volume"
  ]
}
