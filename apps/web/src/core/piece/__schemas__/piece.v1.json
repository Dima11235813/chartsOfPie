{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "charts-of-pie/piece"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sound": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "scale": {
          "type": "string",
          "enum": [
            "major-pentatonic",
            "minor-pentatonic",
            "ionian",
            "dorian",
            "phrygian",
            "lydian",
            "mixolydian",
            "aeolian",
            "locrian",
            "harmonic-minor",
            "melodic-minor",
            "blues",
            "whole-tone",
            "chromatic"
          ]
        },
        "root": {
          "type": "string",
          "enum": [
            "C",
            "C#",
            "D",
            "D#",
            "E",
            "F",
            "F#",
            "G",
            "G#",
            "A",
            "A#",
            "B"
          ]
        },
        "octave": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5
        },
        "mapping": {
          "type": "string",
          "enum": [
            "ascending",
            "centred",
            "wrap",
            "semitones"
          ]
        },
        "rhythm": {
          "type": "string",
          "enum": [
            "legacy",
            "steady",
            "steady-rests",
            "digit-length"
          ]
        },
        "timing": {
          "type": "string",
          "enum": [
            "legacy-random",
            "tempo"
          ]
        },
        "bpm": {
          "type": "number",
          "minimum": 30,
          "maximum": 240
        },
        "subdivision": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 4
            }
          ]
        },
        "swing": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "legato": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "dynamics": {
          "type": "string",
          "enum": [
            "flat",
            "accented"
          ]
        },
        "humanize": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "instrument": {
          "type": "string",
          "enum": [
            "classic",
            "piano",
            "electric-piano",
            "music-box",
            "marimba",
            "harp",
            "warm-pad",
            "pure-sine",
            "electric-guitar",
            "acoustic-guitar",
            "wurlitzer",
            "clavinet",
            "organ",
            "analog-synth"
          ]
        },
        "reverb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "echo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "drone": {
          "type": "boolean"
        },
        "compress": {
          "type": "boolean"
        },
        "volume": {
          "type": "number",
          "minimum": -30,
          "maximum": 6
        }
      },
      "required": [
        "version",
        "scale",
        "root",
        "octave",
        "mapping",
        "rhythm",
        "timing",
        "bpm",
        "subdivision",
        "legato",
        "dynamics",
        "humanize",
        "instrument",
        "reverb",
        "echo",
        "drone",
        "compress",
        "volume"
      ]
    },
    "visual": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "view": {
          "default": "chart",
          "type": "string",
          "enum": [
            "chart",
            "staff",
            "spectrogram",
            "ring",
            "walk",
            "sunflower",
            "mosaic",
            "hilbert",
            "type",
            "strings",
            "clock",
            "harmonograph",
            "scope",
            "fretboard",
            "cymatics"
          ]
        },
        "palette": {
          "default": "rainbow",
          "type": "string",
          "enum": [
            "rainbow",
            "colour-blind",
            "scriabin",
            "ink"
          ]
        },
        "chartStyle": {
          "default": "bar",
          "type": "string",
          "enum": [
            "bar",
            "horizontalBar",
            "line",
            "polarArea",
            "doughnut",
            "pie",
            "radar"
          ]
        },
        "viewOptions": {
          "default": {},
          "type": "object",
          "properties": {
            "clock": {
              "default": {},
              "type": "object",
              "properties": {
                "order": {
                  "default": "chromatic",
                  "type": "string",
                  "enum": [
                    "chromatic",
                    "fifths"
                  ]
                }
              }
            },
            "harmonograph": {
              "default": {},
              "type": "object",
              "properties": {
                "pure": {
                  "default": false,
                  "type": "boolean"
                },
                "golden": {
                  "default": false,
                  "type": "boolean"
                }
              }
            },
            "sunflower": {
              "default": {},
              "type": "object",
              "properties": {
                "spirals": {
                  "default": false,
                  "type": "boolean"
                }
              }
            },
            "stringArt": {
              "default": {},
              "type": "object",
              "properties": {
                "mode": {
                  "default": "digits",
                  "type": "string",
                  "enum": [
                    "digits",
                    "golden"
                  ]
                }
              }
            },
            "scope": {
              "default": {},
              "type": "object",
              "properties": {
                "mode": {
                  "default": "vector",
                  "type": "string",
                  "enum": [
                    "vector",
                    "wave"
                  ]
                }
              }
            },
            "fretboard": {
              "default": {},
              "type": "object",
              "properties": {
                "tuning": {
                  "default": "standard",
                  "type": "string",
                  "enum": [
                    "standard",
                    "drop-d",
                    "dadgad",
                    "open-g"
                  ]
                }
              }
            },
            "mosaic": {
              "default": {},
              "type": "object",
              "properties": {
                "columns": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120
                },
                "minGroup": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                },
                "sweep": {
                  "default": false,
                  "type": "boolean"
                },
                "sweepSpeed": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 5
                }
              }
            }
          }
        }
      },
      "required": [
        "version"
      ]
    },
    "source": {
      "default": {
        "version": 1,
        "series": "pi",
        "reading": "digits"
      },
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "series": {
          "type": "string",
          "enum": [
            "pi",
            "phi",
            "e",
            "sqrt2"
          ]
        },
        "reading": {
          "type": "string",
          "enum": [
            "digits"
          ]
        }
      },
      "required": [
        "version",
        "series",
        "reading"
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "digitIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "start": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digitIndex"
      ]
    }
  },
  "required": [
    "schema",
    "version",
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "sound",
    "visual"
  ]
}
