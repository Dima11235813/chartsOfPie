# Local ports for the web app. Copy to .env.local and pick ports allowed by the owner's
# "Port allocation and resource usage rules" (Google Drive → project management).
# npm run dev
WEB_PORT=5173
# npm run preview
PREVIEW_PORT=4173
# Playwright servers (CLI env vars, not read from this file): E2E_PORT=4173 AUDIO_PORT=5179 PERF_PORT=4180

# Offline mode is the default: with no VITE_API_URL, accounts are hidden and pieces stay in the
# browser (this is how the published site is built). For local full-stack work, put this line in
# .env.development.local (dev server only, so `npm run build` and the e2e tests stay offline):
# VITE_API_URL=http://localhost:8787
