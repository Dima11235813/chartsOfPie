{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "sh",
      "args": ["scripts/chrome-devtools-mcp.sh"]
    }
  }
}
